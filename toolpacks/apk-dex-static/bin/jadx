#!/usr/bin/env sh
set -eu

TOOLPACK_ROOT=${AUTOC_TOOLPACK_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}

# JADX upstream defaults to MaxRAMPercentage=70%, which is too aggressive for an Android phone.
# Keep a predictable mobile-safe budget unless the caller explicitly overrides it.
JADX_HEAP_MB=${AUTOC_JADX_HEAP_MB:-768}
JADX_THREADS=${AUTOC_JADX_THREADS:-2}
case "$JADX_HEAP_MB" in ''|*[!0-9]*) echo "jadx: invalid AUTOC_JADX_HEAP_MB" >&2; exit 2 ;; esac
case "$JADX_THREADS" in ''|*[!0-9]*) echo "jadx: invalid AUTOC_JADX_THREADS" >&2; exit 2 ;; esac
[ "$JADX_HEAP_MB" -ge 1 ] || { echo "jadx: heap must be a positive number of MB" >&2; exit 2; }
[ "$JADX_THREADS" -ge 1 ] || { echo "jadx: threads must be positive" >&2; exit 2; }

if [ "${1:-}" = "--autocrack-policy" ]; then
  printf 'AUTOC_JADX_HEAP_MB=%s\nAUTOC_JADX_THREADS=%s\n' "$JADX_HEAP_MB" "$JADX_THREADS"
  exit 0
fi

USER_JADX_OPTS=${JADX_OPTS:-}
export JADX_OPTS="-Xms64M -Xmx${JADX_HEAP_MB}M -XX:ActiveProcessorCount=${JADX_THREADS} -XX:ParallelGCThreads=2 -XX:ConcGCThreads=1 ${USER_JADX_OPTS}"

HAS_THREADS=0
for ARG in "$@"; do
  case "$ARG" in
    --threads-count|--threads-count=*) HAS_THREADS=1 ;;
  esac
done

if [ "$HAS_THREADS" -eq 1 ]; then
  exec /bin/sh "$TOOLPACK_ROOT/lib/jadx/bin/jadx" "$@"
fi
exec /bin/sh "$TOOLPACK_ROOT/lib/jadx/bin/jadx" --threads-count "$JADX_THREADS" "$@"
