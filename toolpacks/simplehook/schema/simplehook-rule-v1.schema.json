{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckylca/AutoCrackApp/toolpacks/simplehook/schema/simplehook-rule-v1.schema.json",
  "title": "SimpleHook Rule v1",
  "$defs": {
    "className": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"
    },
    "typeName": {
      "type": "string",
      "pattern": "^(boolean|byte|short|int|long|float|double|char|void|String|[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*)(\\[\\])?$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "enabled", "package", "target", "action"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "enabled": {"type": "boolean"},
    "package": {"$ref": "#/$defs/className"},
    "process": {"type": ["string", "null"], "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "parameters"],
      "properties": {
        "class": {"$ref": "#/$defs/className"},
        "method": {"type": "string", "pattern": "^(<init>|[A-Za-z_$][A-Za-z0-9_$]*\\*?)$"},
        "constructor": {"type": "boolean", "default": false},
        "parameters": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/typeName"}},
        "return_type": {"anyOf": [{"$ref": "#/$defs/typeName"}, {"type": "null"}]},
        "field": {"type": ["string", "null"], "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["record", "replace_return", "replace_argument", "before", "after", "skip_original", "field_read", "field_write", "field_record"]},
        "value": {},
        "argument_index": {"type": "integer", "minimum": 0}
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "arguments": {"type": "boolean"},
        "return_value": {"type": "boolean"},
        "stack_trace": {"type": "boolean"}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "operator"],
      "properties": {
        "source": {"enum": ["argument", "return_value", "field"]},
        "index": {"type": "integer", "minimum": 0},
        "operator": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains", "starts_with", "ends_with", "is_null", "not_null"]},
        "value": {}
      }
    }
  }
}
