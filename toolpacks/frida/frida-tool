#!/bin/sh
set -eu
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PACK_ROOT=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
export PYTHONPATH="$PACK_ROOT/python${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
COMMAND=$(basename "$0")
exec /usr/bin/python3 -B "$PACK_ROOT/libexec/frida_tools_launcher.py" "$COMMAND" "$@"
