#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RIZIN="$ROOT/lib/rizin/rizin"

if [ "${1:-}" = "--self-test" ]; then
  for command_name in python3 file sha256sum; do
    command -v "$command_name" >/dev/null || {
      echo "Missing required command: $command_name" >&2
      exit 10
    }
  done
  "$RIZIN" -v | grep -F "0.9.1" >/dev/null
  echo RZ_DEEP_REPORT_SELF_TEST_OK
  exit 0
fi

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  echo "Usage: rz-deep-report <ELF-or-SO-file> [output-directory-under-/workspace]" >&2
  exit 2
fi

TARGET=$1
[ -f "$TARGET" ] || { echo "Input file not found: $TARGET" >&2; exit 3; }
file "$TARGET" | grep -q 'ELF' || { echo "Not an ELF file: $TARGET" >&2; exit 4; }

BASE=$(basename -- "$TARGET")
SAFE_BASE=$(printf '%s' "$BASE" | tr -c 'A-Za-z0-9._-' '_')
OUT=${2:-/workspace/rizin-report-$SAFE_BASE}
case "$OUT" in
  /workspace/*) ;;
  *) echo "Output directory must be under /workspace: $OUT" >&2; exit 5 ;;
esac

mkdir -p "$OUT"
: > "$OUT/rizin.stderr"
sha256sum "$TARGET" > "$OUT/sha256.txt"
file "$TARGET" > "$OUT/file.txt"

run_json() {
  output_name=$1
  commands=$2
  "$RIZIN" -q -c "$commands" "$TARGET" \
    > "$OUT/$output_name" 2>> "$OUT/rizin.stderr"
  python3 -m json.tool "$OUT/$output_name" >/dev/null
}

run_json info.json 'ij'
run_json sections.json 'iSj'
run_json segments.json 'iSSj'
run_json imports.json 'iij'
run_json exports.json 'iEj'
run_json symbols.json 'isj'
run_json strings.json 'izj'
run_json relocations.json 'irj'
run_json functions.json 'aaa; aflj'
run_json callgraph.json 'aaa; agCj'
run_json entry-disasm.json 'aaa; s entry0; pdj 128'

python3 - "$OUT" "$TARGET" <<'PY'
import json
import sys
from pathlib import Path

out = Path(sys.argv[1])
target = sys.argv[2]

def read_json(name, default):
    try:
        return json.loads((out / name).read_text(encoding="utf-8"))
    except Exception:
        return default

info = read_json("info.json", {})
imports = read_json("imports.json", [])
exports = read_json("exports.json", [])
symbols = read_json("symbols.json", [])
strings = read_json("strings.json", [])
relocations = read_json("relocations.json", [])
functions = read_json("functions.json", [])
callgraph = read_json("callgraph.json", [])
entry_disasm = read_json("entry-disasm.json", [])

summary = {
    "tool": "AutoCrackApp Rizin deep report",
    "input": target,
    "output": str(out),
    "sha256": (out / "sha256.txt").read_text().split()[0],
    "file": (out / "file.txt").read_text().strip(),
    "binary": info.get("bin", {}) if isinstance(info, dict) else {},
    "counts": {
        "imports": len(imports) if isinstance(imports, list) else 0,
        "exports": len(exports) if isinstance(exports, list) else 0,
        "symbols": len(symbols) if isinstance(symbols, list) else 0,
        "strings": len(strings) if isinstance(strings, list) else 0,
        "relocations": len(relocations) if isinstance(relocations, list) else 0,
        "functions": len(functions) if isinstance(functions, list) else 0,
        "callgraphNodes": len(callgraph) if isinstance(callgraph, list) else 0,
        "entryInstructions": len(entry_disasm) if isinstance(entry_disasm, list) else 0,
    },
}
(out / "summary.json").write_text(
    json.dumps(summary, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
(out / "summary.txt").write_text(
    "\n".join([
        "AutoCrackApp Rizin deep report",
        f"input={target}",
        f"output={out}",
        f"sha256={summary['sha256']}",
        f"functions={summary['counts']['functions']}",
        f"imports={summary['counts']['imports']}",
        f"exports={summary['counts']['exports']}",
        f"strings={summary['counts']['strings']}",
        f"relocations={summary['counts']['relocations']}",
    ]) + "\n",
    encoding="utf-8",
)
PY

echo "RZ_DEEP_REPORT_OK output=$OUT"
