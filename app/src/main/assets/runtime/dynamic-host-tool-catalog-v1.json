{
  "schemaVersion": 1,
  "catalogVersion": "0.5.14.2",
  "scope": "host_dynamic_scoped",
  "safetyBoundary": {
    "ownedOrAuthorizedDevicesOnly": true,
    "defaultOperationMode": "read_only",
    "readOnly": false,
    "attachAllowed": true,
    "attachRequiresExplicitAuthorization": true,
    "debuggerExecutionControlAllowed": true,
    "debuggerExecutionControlRequiresExplicitAuthorization": true,
    "registerReadAllowed": true,
    "registerWriteAllowed": false,
    "memoryReadAllowed": true,
    "memoryWriteAllowed": false,
    "breakpointAllowed": false,
    "rawDebuggerPacketAllowed": false,
    "signalsAllowed": false,
    "injectionAllowed": false,
    "targetFileWriteAllowed": false,
    "helperSessionLifecycleAllowed": true,
    "debuggerAttachDetachAllowed": true,
    "orphanDebuggerRecoveryAllowed": true,
    "orphanDebuggerRecoveryRequiresExactAuthorization": true,
    "audit": "runtime/audit/dynamic-host-read.jsonl",
    "logcatAudit": "runtime/audit/dynamic-logcat.jsonl",
    "debuggerAudit": "runtime/audit/dynamic-debugger.jsonl",
    "debuggerControlAudit": "runtime/audit/dynamic-debugger-control.jsonl",
    "debuggerRecoveryAudit": "runtime/audit/dynamic-debugger-recovery.jsonl"
  },
  "tools": [
    {
      "id": "host.process.list",
      "title": "List Android host processes from procfs",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none",
      "inputs": {"filter": "optional literal process/package substring", "maxCount": "1..2000"},
      "output": "HostProcessListReport",
      "implementation": "RootToolCommand.ListHostProcesses"
    },
    {
      "id": "host.process.identity",
      "title": "Read PID identity and security status",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none",
      "inputs": {"pid": "positive integer"},
      "reads": ["/proc/<pid>/status", "/proc/<pid>/cmdline", "/proc/<pid>/exe", "/proc/<pid>/cwd", "/proc/<pid>/root", "/proc/<pid>/attr/current"],
      "output": "CommandResult",
      "implementation": "RootToolCommand.ReadProcessIdentity"
    },
    {
      "id": "host.process.attach_preflight",
      "title": "Read debugger attach prerequisites without attaching",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none",
      "inputs": {"pid": "positive integer"},
      "output": "CommandResult",
      "guarantees": ["attachAttempted=false", "stateChanged=false", "no ptrace", "no target signal", "no target memory access"],
      "implementation": "RootToolCommand.ReadProcessAttachPreflight"
    },
    {
      "id": "host.process.maps",
      "title": "Read process memory maps and aggregate loaded files",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none",
      "inputs": {"pid": "positive integer"},
      "reads": ["/proc/<pid>/maps"],
      "output": "CommandResult + HostLoadedModule[]",
      "implementation": "RootToolCommand.ReadProcessMaps"
    },
    {
      "id": "host.process.threads",
      "title": "List bounded target threads",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none",
      "inputs": {"pid": "positive integer", "maxCount": "1..8192"},
      "reads": ["/proc/<pid>/task/*/comm", "/proc/<pid>/task/*/status"],
      "output": "bounded TSV CommandResult",
      "implementation": "RootToolCommand.ListProcessThreads"
    },
    {
      "id": "host.process.fds",
      "title": "List bounded target file descriptors",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none",
      "inputs": {"pid": "positive integer", "maxCount": "1..4096"},
      "reads": ["/proc/<pid>/fd/*"],
      "output": "bounded TSV CommandResult",
      "implementation": "RootToolCommand.ListProcessFileDescriptors"
    },
    {
      "id": "host.logcat.session",
      "title": "Run a PID-scoped Android logcat helper session",
      "runtime": "typed_root_host_session",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION", "LOGCAT_READ"],
      "changesState": true,
      "changesTargetState": false,
      "confirmation": "explicit_user_action",
      "inputs": {"packageName": "validated Android package name", "pid": "positive integer whose current argv0 must match packageName or packageName:*"},
      "command": "logcat --pid=<pid> -v threadtime",
      "output": "HostLogcatSessionSnapshot",
      "artifacts": ["runtime/sessions/logcat/<sessionId>.log", "runtime/audit/dynamic-logcat.jsonl"],
      "implementation": "HostLogcatSessionManager"
    },
    {
      "id": "host.debugger.lldb_server_session",
      "title": "Explicitly attach and detach a trusted Android LLDB server",
      "runtime": "typed_root_host_session",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION", "DEBUGGER_ATTACH"],
      "requiresToolpack": {"id": "android-lldb-server", "version": "ndk-r27d-clang-r522817d_autocrack-1.0.0"},
      "changesState": true,
      "changesTargetState": true,
      "confirmation": "exact_target_phrase",
      "authorizationTemplate": "ATTACH <packageName> <pid>",
      "inputs": {"packageName": "validated Android package name", "pid": "positive integer; AutoCrack controller PID is rejected", "port": "validated loopback TCP port"},
      "networkScope": "127.0.0.1 only",
      "networkAddressFamily": "IPv4",
      "output": "HostDebuggerSessionSnapshot",
      "artifacts": ["runtime/audit/dynamic-debugger.jsonl"],
      "guarantees": [
        "revalidate package/PID identity immediately before attach",
        "reject a target whose TracerPid is already nonzero",
        "bind LLDB gdb-remote server to IPv4 loopback 127.0.0.1 only",
        "helper teardown never signals the target PID",
        "detach verification requires TracerPid to return to 0"
      ],
      "implementation": "HostDebuggerSessionManager"
    },
    {
      "id": "host.debugger.client_control",
      "title": "Bounded loopback LLDB client observation and execution control",
      "runtime": "typed_loopback_debugger_client",
      "requiresCapabilities": ["DEBUGGER_ATTACH", "DEBUGGER_READ", "DEBUGGER_EXECUTION_CONTROL"],
      "requiresActiveTool": "host.debugger.lldb_server_session",
      "changesState": true,
      "changesTargetState": true,
      "confirmation": "exact_target_phrase",
      "authorizationTemplate": "CONTROL <packageName> <pid>",
      "networkScope": "127.0.0.1 only",
      "networkAddressFamily": "IPv4",
      "operations": [
        {"id": "stop_reason", "changesTargetState": false},
        {"id": "register_read", "changesTargetState": false, "maxRegisters": 128},
        {"id": "memory_read", "changesTargetState": false, "maxBytes": 512},
        {"id": "continue", "changesTargetState": true},
        {"id": "step", "changesTargetState": true},
        {"id": "interrupt", "changesTargetState": true}
      ],
      "output": "HostDebuggerControlSnapshot",
      "artifacts": ["runtime/audit/dynamic-debugger-control.jsonl"],
      "guarantees": [
        "construct client endpoint from literal IPv4 loopback bytes rather than localhost resolution",
        "no arbitrary raw gdb-remote packet adapter",
        "no register write adapter",
        "no memory write adapter",
        "no breakpoint insertion or removal adapter",
        "memory reads are bounded to 512 bytes in the UI bridge",
        "execution control requires exact CONTROL package/PID authorization",
        "interrupt is a gdb-remote protocol byte, not kill(targetPid)"
      ],
      "implementation": "HostDebuggerControlBridge + HostDebuggerRemoteClient"
    },
    {
      "id": "host.debugger.orphan_recovery",
      "title": "Safely detach an orphaned AutoCrack LLDB helper after controller restart",
      "runtime": "typed_root_host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION", "DEBUGGER_ATTACH"],
      "requiresToolpack": {"id": "android-lldb-server", "version": "ndk-r27d-clang-r522817d_autocrack-1.0.0"},
      "changesState": true,
      "changesTargetState": true,
      "confirmation": "exact_target_and_tracer_phrase",
      "authorizationTemplate": "RECOVER <packageName> <pid> <tracerPid>",
      "output": "HostDebuggerRecoverySnapshot",
      "artifacts": ["runtime/audit/dynamic-debugger-recovery.jsonl"],
      "guarantees": [
        "never terminate a tracer from PID alone",
        "revalidate target package identity and current TracerPid immediately before recovery",
        "require tracer argv0 to equal the trusted lldb-server-android binary path",
        "require tracer cmdline to contain gdbserver loopback mode and --attach <targetPid>",
        "revalidate the exact expected tracer PID immediately before TERM",
        "send TERM only to the verified LLDB helper and never to the target PID",
        "never escalate recovery to SIGKILL",
        "require final target TracerPid=0 for detachVerified=true"
      ],
      "implementation": "HostDebuggerRecoveryBridge"
    }
  ]
}
