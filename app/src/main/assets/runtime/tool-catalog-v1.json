{
  "schemaVersion": 1,
  "catalogVersion": "0.5.10-hotfix1",
  "runtimeTarget": "android_rootfs_only",
  "runtimeTargetNotes": [
    "Agent-callable production tools run only in the Android app, Android root shell, Android loopback, or Debian ARM64 rootfs.",
    "GitHub Actions may build toolpack artifacts, but final Agent runtime must not depend on desktop-side services or developer machine paths.",
    "Legacy runtime names containing host mean Android host OS, not a desktop host. New tools should prefer android/device/rootfs names."
  ],
  "priorityModes": [
    "FULL_ROOT",
    "SHIZUKU"
  ],
