{
  "schemaVersion": 1,
  "catalogVersion": "0.5.10-hotfix1",
  "priorityModes": ["FULL_ROOT", "SHIZUKU"],
  "tools": [
    {
      "id": "runtime.health",
      "title": "Inspect Root runtime health",
      "runtime": "host_bridge",
      "requiresCapabilities": ["ROOT_IDENTITY"],
      "changesState": false,
      "confirmation": "none",
      "output": "RuntimeHealthReport"
    },
    {
      "id": "shell.exec",
      "title": "Execute a one-shot shell command",
      "runtime": "debian_chroot",
      "requiresCapabilities": ["ROOT_SHELL", "CHROOT"],
      "changesState": "depends_on_command",
      "confirmation": "manual_now_agent_policy_later",
      "inputs": {
        "command": "string",
        "workingDirectory": "managed_path",
        "environment": "map<string,string>",
        "stdin": "optional_string",
        "timeoutMillis": "100..1800000"
      },
      "output": "ShellCommandResult",
      "audit": "runtime/audit/chroot-exec.jsonl"
    },
    {
      "id": "shell.cancel_all",
      "title": "Cancel all active one-shot shell commands",
      "runtime": "root_host_foundation",
      "requiresCapabilities": ["ROOT_SHELL"],
      "changesState": true,
      "confirmation": "none",
      "output": "cancelled_process_count"
    },
    {
      "id": "pty.open",
      "title": "Open a persistent Debian PTY session",
      "runtime": "native_pty",
      "requiresCapabilities": ["ROOT_SHELL", "CHROOT", "PTY"],
      "changesState": true,
      "confirmation": "none",
      "audit": "runtime/audit/pty-sessions.jsonl"
    },
    {
      "id": "pty.process_tree",
      "title": "Inspect the active PTY process subtree",
      "runtime": "host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_INSPECTION"],
      "changesState": false,
      "confirmation": "none"
    },
    {
      "id": "pty.terminate",
      "title": "Send SIGTERM to every process group in the active PTY subtree",
      "runtime": "host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_SIGNAL"],
      "changesState": true,
      "confirmation": "required"
    },
    {
      "id": "pty.kill",
      "title": "Send SIGKILL to every process group in the active PTY subtree",
      "runtime": "host_bridge",
      "requiresCapabilities": ["ROOT_SHELL", "PROCESS_SIGNAL"],
      "changesState": true,
      "confirmation": "two_step_required"
    },
    {
