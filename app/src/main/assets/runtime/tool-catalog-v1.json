      "runtime": "debian_chroot",
      "requiresCapabilities": ["CHROOT", "TOOLPACK_RIZIN_DEEP_STATIC", "WORKSPACE_READ"],
      "changesState": false,
      "confirmation": "none",
      "commandTemplate": "rz-disasm <workspace-elf-or-so> <address-or-symbol> [1..4096]",
      "output": "Bounded disassembly JSON"
    },
    {
      "id": "native.rz_deep_report",
      "title": "Generate a complete workspace-scoped Rizin static report",
      "runtime": "debian_chroot",
      "requiresCapabilities": ["CHROOT", "TOOLPACK_RIZIN_DEEP_STATIC", "WORKSPACE_READ", "WORKSPACE_WRITE"],
      "changesState": true,
      "confirmation": "workspace_write",
      "commandTemplate": "rz-deep-report <workspace-elf-or-so> </workspace/report-directory>",
      "expectedArtifacts": [
        "summary.json",
        "summary.txt",
        "info.json",
        "sections.json",
        "segments.json",
        "imports.json",
        "exports.json",
        "symbols.json",
        "strings.json",
        "relocations.json",
        "functions.json",
        "callgraph.json",
        "entry-disasm.json"
