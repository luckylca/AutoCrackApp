      "requiresCapabilities": [
        "ROOT_SHELL",
        "CHROOT"
      ],
      "changesState": "depends_on_command",
      "confirmation": "manual_now_agent_policy_later",
      "inputs": {
        "command": "string",
        "workingDirectory": "managed_path",
        "environment": "map<string,string>",
        "stdin": "optional_string",
