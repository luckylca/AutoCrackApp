      "changesState": true,
      "confirmation": "required",
      "status": "available"
    },
    {
      "id": "toolpack.install",
      "title": "Verify and install a versioned reverse-analysis toolpack",
      "runtime": "app_workspace",
      "requiresCapabilities": ["CHROOT", "WORKSPACE_WRITE"],
      "changesState": true,
      "confirmation": "required",
      "inputs": {
        "package": "manifest.json + payload.zip",
        "verification": "payload and upstream SHA-256"
      },
      "audit": "runtime/toolpacks/toolpack-audit.jsonl"
    },
    {
      "id": "toolpack.self_test",
      "title": "Run manifest-defined read-only tool self-tests",
      "runtime": "debian_chroot",
      "requiresCapabilities": ["CHROOT"],
      "changesState": false,
      "confirmation": "none",
      "output": "ToolpackSelfTestReport"
    },
    {
